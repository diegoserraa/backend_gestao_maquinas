# ===== App =====
PORT=3000
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# ===== Auth =====
JWT_SECRET=troque-isto
JWT_EXPIRES=2h

# ===== Supabase =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ===== Web Push (VAPID) =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ===== MQTT / Telemetria ESP32 (HiveMQ Cloud) =====
# mqtts:// = TLS (porta 8883 no HiveMQ Cloud). Deixe MQTT_URL vazio para
# desligar a ingestao de telemetria (o resto da API continua funcionando).
MQTT_URL=mqtts://SEU-CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=maquinas/+/telemetria
MQTT_CLIENT_ID=backend-maquinas

# Endereço do front-end (o QR Code das máquinas aponta para ele). Em produção: o domínio definitivo, com https
FRONTEND_URL=http://localhost:5173
